# Xiaohongshu Configuration
PHONE=your_phone_number
JSON_PATH=/path/to/cookies
IMAGE_PATH=/path/to/screenshot.png

# Qwen API Configuration
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Jina API Configuration
JINA_API_KEY=your_jina_api_key

# File Paths
BASE_PATH=/path/to/xhs-service
PERSONALITY_FILE=${BASE_PATH}/personality.json
UNDERSTANDINGS_FILE=${BASE_PATH}/understandings.json
MEMORIES_FILE=${BASE_PATH}/memories.json
POSTS_FILE=${BASE_PATH}/posts.json
KNOWLEDGE_FILE=${BASE_PATH}/knowledge.json